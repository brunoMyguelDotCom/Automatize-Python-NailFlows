# Backend Supabase (não use a chave publishable para acesso service_role).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa legada: SUPABASE_KEY=

# Credenciais OAuth do Google (tipo Aplicativo da Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# mock para desenvolvimento sem Google; google para integração real
CALENDAR_BACKEND=mock
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_FILE=.secrets/google-token.enc
